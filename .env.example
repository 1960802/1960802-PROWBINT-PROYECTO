# ============================================================
#  WhiteArt - Configuracion de entorno
#  Copia este archivo como .env y ajusta los valores.
# ============================================================

APP_NAME="WhiteArt"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# ---------- Base de datos (XAMPP / MariaDB) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=whiteart
DB_USER=root
DB_PASS=

# ---------- CORS ----------
# Origenes permitidos, separados por coma. Nunca uses "*" con credenciales.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost

# ---------- Sesion ----------
SESSION_NAME=whiteart_sid
SESSION_LIFETIME=7200
# Lax para mismo sitio; None solo con HTTPS
SESSION_SAMESITE=Lax

# ---------- PayPal Orders v2 (API de terceros) ----------
# Modo: sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# true = no llama a PayPal, simula la orden para poder probar el flujo completo.
# Cambia a false en cuanto pegues las credenciales de sandbox.
PAYPAL_DEMO=true
PAYPAL_CURRENCY=USD

# ---------- Subidas ----------
UPLOAD_MAX_MB=5
